<Window x:Class="JTW.NetworkScanner.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource JtwWindow}"
        Title="Settings" Width="860" Height="680" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <TabControl x:Name="Tabs">

            <!-- DNS -->
            <TabItem Header="DNS" x:Name="DnsTab">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="⟳ Refresh" Click="DnsRefresh_Click" />
                        <Label Content="Adapter" />
                        <ComboBox x:Name="DnsAdapterCombo" SelectionChanged="DnsAdapterCombo_SelectionChanged" />
                    </DockPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SubText}" Text="CURRENT DNS ON THIS ADAPTER" />
                            <TextBlock x:Name="CurrentDnsText" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="CurrentModeText" Style="{StaticResource SubText}" />
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="PresetList" Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="PresetList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="10,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding LatencyText}" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{StaticResource AccentBrush}" Margin="10,0,0,0" />
                                    <StackPanel>
                                        <TextBlock>
                                            <Run Text="{Binding Preset.Name, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="{Binding CurrentMarker, Mode=OneWay}" Foreground="{StaticResource GoodBrush}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Preset.ServersText}" Foreground="{StaticResource AccentBrush}" FontSize="11.5" />
                                        <TextBlock Text="{Binding Preset.Description}" Style="{StaticResource SubText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="CustomPanel" Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0" IsEnabled="False">
                        <Label Content="Custom primary" />
                        <TextBox x:Name="CustomPrimary" Width="150" />
                        <Label Content="   secondary" />
                        <TextBox x:Name="CustomSecondary" Width="150" />
                        <TextBlock Text="  (IPv4 or IPv6)" Style="{StaticResource SubText}" VerticalAlignment="Center" />
                    </StackPanel>

                    <DockPanel Grid.Row="4" Margin="0,10,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Benchmark resolvers" Click="DnsBenchmark_Click" x:Name="BenchmarkButton" />
                            <Button Content="Flush DNS cache" Click="DnsFlush_Click" />
                            <Button x:Name="DnsApplyButton" Content="Apply to adapter" Style="{StaticResource AccentButton}" Click="DnsApply_Click" />
                        </StackPanel>
                        <CheckBox x:Name="Ipv6Check" Content="Also set IPv6 DNS servers" IsChecked="True" />
                    </DockPanel>

                    <TextBlock x:Name="DnsStatus" Grid.Row="5" Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Changing DNS needs administrator rights, so Windows will show a UAC prompt. The DNS cache is flushed automatically afterwards." />
                </Grid>
            </TabItem>

            <!-- General -->
            <TabItem Header="General" x:Name="GeneralTab">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Label Content="Default SSH username" />
                    <TextBox x:Name="SshUserBox" Grid.Column="1" Width="220" HorizontalAlignment="Left" />
                    <Label Grid.Row="1" Content="Ping timeout (ms)" />
                    <TextBox x:Name="PingTimeoutBox" Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left" />
                    <Label Grid.Row="2" Content="Port connect timeout (ms)" />
                    <TextBox x:Name="PortTimeoutBox" Grid.Row="2" Grid.Column="1" Width="80" HorizontalAlignment="Left" />
                    <Label Grid.Row="3" Content="Speed test port" />
                    <TextBox x:Name="SpeedPortBox" Grid.Row="3" Grid.Column="1" Width="80" HorizontalAlignment="Left" />
                    <Label Grid.Row="4" Content="Default ports to scan" />
                    <TextBox x:Name="DefaultPortsBox" Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" Height="60" VerticalContentAlignment="Top" />
                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Save" Style="{StaticResource AccentButton}" MinWidth="90" Click="GeneralSave_Click" />
                        <Button Content="Restore defaults" Click="GeneralDefaults_Click" />
                        <Button Content="Open data folder" Click="OpenDataFolder_Click" />
                    </StackPanel>
                    <TextBlock x:Name="GeneralStatus" Grid.Row="6" Grid.ColumnSpan="2" Style="{StaticResource SubText}" Margin="0,12,0,0" />
                </Grid>
            </TabItem>

            <!-- Updates -->
            <TabItem Header="Updates" x:Name="UpdatesTab">
                <StackPanel Margin="16">
                    <TextBlock x:Name="UpdVersionText" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,6,0,12"
                               Text="The app updates itself. When a new version is published it is downloaded, checked against its SHA-256, installed over this copy and the app restarts. There's no need to download anything from GitHub manually." />
                    <CheckBox x:Name="AutoUpdateCheck" Content="Automatically check for updates (at startup and every 6 hours)" Margin="0,0,0,12" Click="AutoUpdate_Click" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Check for updates now" Style="{StaticResource AccentButton}" Click="UpdCheckNow_Click" />
                        <Button Content="View all releases" Click="UpdReleases_Click" />
                    </StackPanel>
                    <TextBlock x:Name="UpdStatus" Style="{StaticResource SubText}" Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
