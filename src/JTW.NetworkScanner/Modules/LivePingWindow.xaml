<local:ModuleWindowBase x:Class="JTW.NetworkScanner.Modules.LivePingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JTW.NetworkScanner.Modules"
        Title="Live Ping" Width="1060" Height="700">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="StartButton" Content="▶  Start" Style="{StaticResource AccentButton}" MinWidth="90" Click="Start_Click" />
                <Button Content="Export…" Click="Export_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="Target" />
                <TextBox x:Name="TargetBox" Width="260" ToolTip="IP address or hostname (e.g. 192.168.1.1, 8.8.8.8, bbc.co.uk)" KeyDown="TargetBox_KeyDown" />
                <Label Content="   Interval" />
                <ComboBox x:Name="IntervalCombo" Width="90" SelectedIndex="1">
                    <ComboBoxItem Content="0.5 s" Tag="500" />
                    <ComboBoxItem Content="1 s" Tag="1000" />
                    <ComboBoxItem Content="2 s" Tag="2000" />
                    <ComboBoxItem Content="5 s" Tag="5000" />
                </ComboBox>
                <CheckBox x:Name="TraceCheck" Content="Map route (trace hops &amp; ping each)" IsChecked="True" Margin="12,0" />
            </StackPanel>
        </DockPanel>

        <!-- Stats -->
        <UniformGrid Grid.Row="1" Rows="1" Margin="0,10,0,10">
            <Border Style="{StaticResource Card}" Margin="0,0,6,0"><StackPanel><TextBlock Text="Sent" Style="{StaticResource SubText}" /><TextBlock x:Name="SentText" Text="0" Style="{StaticResource StatValue}" /></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,6,0"><StackPanel><TextBlock Text="Received" Style="{StaticResource SubText}" /><TextBlock x:Name="RecvText" Text="0" Style="{StaticResource StatValue}" /></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,6,0"><StackPanel><TextBlock Text="Loss" Style="{StaticResource SubText}" /><TextBlock x:Name="LossText" Text="0%" Style="{StaticResource StatValue}" /></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,6,0"><StackPanel><TextBlock Text="Last" Style="{StaticResource SubText}" /><TextBlock x:Name="LastText" Text="—" Style="{StaticResource StatValue}" /></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,6,0"><StackPanel><TextBlock Text="Min / Avg / Max" Style="{StaticResource SubText}" /><TextBlock x:Name="MinAvgMaxText" Text="—" Style="{StaticResource StatValue}" FontSize="16" /></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Jitter" Style="{StaticResource SubText}" /><TextBlock x:Name="JitterText" Text="—" Style="{StaticResource StatValue}" /></StackPanel></Border>
        </UniformGrid>

        <TabControl Grid.Row="2" x:Name="Tabs">
            <TabItem Header="Latency">
                <local:LiveGraph x:Name="Graph" Margin="6" />
            </TabItem>
            <TabItem Header="Route (end-to-end)">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                        <ItemsControl x:Name="HopChain">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource Card}" Padding="8" Width="128">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SubText}"><Run Text="Hop " /><Run Text="{Binding Ttl, Mode=OneWay}" /></TextBlock>
                                                <TextBlock Text="{Binding Address}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Hostname}" Style="{StaticResource SubText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Hostname}" />
                                                <TextBlock Text="{Binding RttText}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                                <TextBlock Style="{StaticResource SubText}"><Run Text="loss " /><Run Text="{Binding LossText, Mode=OneWay}" /></TextBlock>
                                                <TextBlock Text="{Binding Location}" Style="{StaticResource SubText}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="➜" FontSize="18" VerticalAlignment="Center" Margin="6,0" Foreground="{StaticResource AccentBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <DataGrid x:Name="HopGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Hop" Binding="{Binding Ttl}" Width="45" />
                            <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="120" />
                            <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="*" />
                            <DataGridTextColumn Header="Last" Binding="{Binding RttText}" Width="70" />
                            <DataGridTextColumn Header="Avg" Binding="{Binding AvgText}" Width="75" />
                            <DataGridTextColumn Header="Min / Max" Binding="{Binding MinMaxText}" Width="90" />
                            <DataGridTextColumn Header="Sent" Binding="{Binding Sent}" Width="50" />
                            <DataGridTextColumn Header="Loss" Binding="{Binding LossText}" Width="55" />
                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="150" />
                            <DataGridTextColumn Header="Network" Binding="{Binding Org}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="World map">
                <local:RouteMap x:Name="Map" />
            </TabItem>
            <TabItem Header="Log">
                <ListBox x:Name="LogList" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" BorderThickness="0" FontFamily="Consolas" />
            </TabItem>
        </TabControl>

        <TextBlock x:Name="StatusLine" Grid.Row="3" Style="{StaticResource SubText}" Margin="0,8,0,0" Text="Enter a target and press Start." />
    </Grid>
</local:ModuleWindowBase>
